{
  "name": "qorechain-failure-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QoreX native testnet wallet test",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:registry",
    "compile:registry": "node scripts/compile-registry.mjs",
    "test:registry": "node --test tests-contract/*-check.mjs",
    "deploy:registry": "npm run compile:registry && node scripts/serve-registry-deploy.mjs",
    "verify:registry": "node scripts/verify-registry.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ethers": "^6.17.0",
    "solc": "0.8.39",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "@ethereumjs/vm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
